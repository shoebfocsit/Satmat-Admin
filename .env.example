# SATMAT Admin — Environment Template
# Copy to .env and fill values. NEVER commit .env with real secrets.
# VITE_* vars are baked into the browser bundle at build time — public only, no secrets.

# Backend API base (dev: localhost, prod: Render URL)
# Use VITE_API_BASE_URL (preferred) or VITE_API_URL (legacy alias — both work)
VITE_API_BASE_URL=http://localhost:8080/api/v1
# VITE_API_BASE_URL=https://satmat-backendfinal.onrender.com/api/v1

# Optional: override dev server port (default 5174 to avoid clash with web:3000 + backend:8080 + website:5173)
# PORT=5174
